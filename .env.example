# ─── Server ───────────────────────────────────────────────────
PORT=4321
# npm run share runs its own server on this port, so the dev backend above can run too
SHARE_PORT=4333
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=playroom

# Hosted MySQL (Aiven, etc.) refuses plaintext and uses its own CA, so paste the
# CA certificate here — the PEM text itself, not a path. Leave both unset for a
# local MySQL. DB_SSL=true alone only works if the host uses a public CA.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----"
# DB_SSL=true

# Connections the pool may open. Free database tiers cap the total (Aiven's
# is 76) and give the server 1GB of RAM, so leave this small.
# DB_POOL_SIZE=10

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change_this_to_something_long_and_random_in_production
JWT_EXPIRES_IN=7d

# ─── Frontend / CORS ──────────────────────────────────────────
# Origin(s) the browser app is served from. In dev, any localhost/127.0.0.1
# port is allowed automatically, so this only really matters in production.
PRODUCTION_URL=http://localhost:3333

# Optional: extra allowed origins, comma-separated (apex + www, staging, …).
# CORS_ORIGINS=https://playroom.example.com,https://www.playroom.example.com
